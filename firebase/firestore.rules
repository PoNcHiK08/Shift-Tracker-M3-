rules_version = '2';

// Security rules for Shift Tracker's cloud sync (Cloud Firestore).
//
// BEFORE PUBLISHING: replace YOUR_EMAIL_HERE below with the address of the Google account you sign in with,
// in the Firebase console (Firestore Database -> Rules), then Publish. Do not commit your real address: this
// repository is public. As committed, these rules let nobody in.
//
// Who: only the signed-in owner of users/{uid}, signed in with Google, with that verified email.
// What: only the documents the app writes, field by field (layout: app/src/main/java/com/vkurylo/shifttracker/
// data/sync/firebase/FirestoreDocuments.kt), and a record only ever replaced by a later version of it.
// Everything else is refused. Tests: firebase/rules-test.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowedEmail() {
      return 'YOUR_EMAIL_HERE';
    }

    function isOwner(uid) {
      return allowedEmail().matches('[^@ ]+@[^@ ]+')
        && request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == allowedEmail().lower();
    }

    // The marker of the account's cloud data (CloudMeta): created once, never changed; deleted by
    // "Delete my cloud data".
    match /users/{uid} {
      allow get, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && hasExactly(request.resource.data, ['epoch', 'createdAt'])
        && request.resource.data.epoch is string
        && request.resource.data.epoch.size() > 0
        && request.resource.data.epoch.size() <= 64
        && request.resource.data.createdAt == request.time;

      match /jobs/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isId(id) && isLater() && isJob(request.resource.data);
      }

      match /shifts/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isId(id) && isLater() && isShift(request.resource.data);
      }

      match /bonuses/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isId(id) && isLater() && isBonus(request.resource.data);
      }

      match /payouts/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isId(id) && isLater() && isPayout(request.resource.data);
      }
    }

    // --- Records -------------------------------------------------------------------------------------

    // Last write wins (LastWriteWins.kt): a record is only replaced by a later version, so no phone can
    // overwrite a newer change with an older one, even one that arrived while it was uploading.
    function isLater() {
      return resource == null || request.resource.data.updatedAt > resource.data.updatedAt;
    }

    // Fields every record has. updatedAt is the phone's clock (it decides conflicts); one running more than
    // 10 minutes ahead of the server is refused, so a wrong clock can't make its changes win for long.
    // serverUpdatedAt must be the server's own time of this write (the app uses it to find changes).
    function isRecord(d) {
      return d.v is int && d.v >= 1
        && d.updatedAt is int && d.updatedAt >= 0
        && d.updatedAt <= request.time.toMillis() + 10 * 60 * 1000
        && d.deleted is bool
        && d.serverUpdatedAt == request.time;
    }

    function isJob(d) {
      return hasExactly(d, ['v', 'updatedAt', 'serverUpdatedAt', 'deleted', 'name', 'hourlyRateGrosze', 'color',
          'secondRate', 'currency', 'payHistory'])
        && isRecord(d)
        && isText(d.name)
        && isAmount(d.hourlyRateGrosze)
        && d.color is int
        && isTimedRate(d.secondRate)
        && d.currency is string && d.currency.size() <= 8
        && d.payHistory is list && d.payHistory.size() <= 1200;
    }

    function isShift(d) {
      return hasExactly(d, ['v', 'updatedAt', 'serverUpdatedAt', 'deleted', 'jobId', 'dateEpochDay', 'startMinute',
          'endMinute', 'unpaidBreakMinutes', 'hourlyRateGrosze', 'note', 'externalUid', 'secondRate'])
        && isRecord(d)
        && isId(d.jobId)
        && d.dateEpochDay is int
        && isMinute(d.startMinute)
        && isMinute(d.endMinute)
        && isMinute(d.unpaidBreakMinutes)
        && isAmount(d.hourlyRateGrosze)
        && isOptionalText(d.note)
        && isOptionalText(d.externalUid)
        && isTimedRate(d.secondRate);
    }

    // A bonus has two accepted shapes, so a phone on the previous app version keeps syncing:
    //  - the original one, without wholeMonth (what the previous version writes);
    //  - the current one, with wholeMonth: true for a bonus that belongs to the whole month of its date.
    // A write that merges the previous version's fields onto a document that already has wholeMonth sees the
    // merged document here, so it passes as the current shape and the field survives.
    function isBonus(d) {
      return (hasExactly(d, ['v', 'updatedAt', 'serverUpdatedAt', 'deleted', 'jobId', 'dateEpochDay', 'amountGrosze', 'note'])
          || (hasExactly(d, ['v', 'updatedAt', 'serverUpdatedAt', 'deleted', 'jobId', 'dateEpochDay', 'amountGrosze', 'note',
              'wholeMonth']) && d.wholeMonth is bool))
        && isRecord(d)
        && isId(d.jobId)
        && d.dateEpochDay is int
        && isAmount(d.amountGrosze)
        && isOptionalText(d.note);
    }

    // The salary that actually arrived, for one job and the month it was earned for. month is yyyymm.
    // Several payouts per job and month are allowed; receivedEpochDay is optional but always present (null).
    function isPayout(d) {
      return hasExactly(d, ['v', 'updatedAt', 'serverUpdatedAt', 'deleted', 'jobId', 'month', 'amountMinor', 'note',
          'receivedEpochDay'])
        && isRecord(d)
        && isId(d.jobId)
        && isMonthKey(d.month)
        && isAmount(d.amountMinor)
        && isOptionalText(d.note)
        && (d.receivedEpochDay == null || d.receivedEpochDay is int);
    }

    // --- Values --------------------------------------------------------------------------------------

    function hasExactly(d, keys) {
      return d.keys().hasAll(keys) && d.keys().hasOnly(keys);
    }

    // A sync id: a lowercase UUID.
    function isId(value) {
      return value is string && value.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    // Money: whole minor units (grosze), never a fraction.
    function isAmount(value) {
      return value is int && value >= 0;
    }

    function isMinute(value) {
      return value is int && value >= 0 && value < 24 * 60;
    }

    // A month as yyyymm (2026-11 is 202611), years 1000-9999.
    function isMonthKey(value) {
      return value is int && value >= 100001 && value <= 999912 && value % 100 >= 1 && value % 100 <= 12;
    }

    // The app's limit for names and notes (TextLimits.kt; a test keeps the two equal). size() counts UTF-16
    // units, as Kotlin's String.length does: 20000 Cyrillic letters pass, an emoji counts 2.
    function isText(value) {
      return value is string && value.size() <= 20000;
    }

    function isOptionalText(value) {
      return value == null || isText(value);
    }

    function isTimedRate(value) {
      return value == null || (value is map
        && hasExactly(value, ['rateGrosze', 'fromMinute', 'toMinute'])
        && isAmount(value.rateGrosze)
        && isMinute(value.fromMinute)
        && isMinute(value.toMinute));
    }
  }
}
