# Copy this file to .env.local (never committed) and fill in the values of your Firebase Web app
# (Firebase console -> Project settings -> Your apps -> the Web app -> SDK setup and configuration -> Config).
# See docs/web.md. Without them the site still opens in demo mode: add ?demo to the address.
VITE_FIREBASE_API_KEY=
# Use the Hosting domain (your-project.web.app), not firebaseapp.com: sign-in by redirect then works in every browser.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
