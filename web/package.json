{
  "name": "shift-tracker-web",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only web version of Shift Tracker (Material 3).",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "strings": "node scripts/sync-strings.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@material/web": "2.5.0",
    "firebase": "13.1.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@material-design-icons/svg": "0.14.15",
    "@types/node": "24.19.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
