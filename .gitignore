# Firebase config for cloud sync: never commit it (CI writes it from the GOOGLE_SERVICES_JSON secret).
google-services.json
# Firestore rules tests (firebase/rules-test)
node_modules/
# Firebase emulator logs
*-debug.log
# Signing keys: your own release key must never be committed (CI reads it from the SIGNING_* secrets).
# The public dev key is the one exception, on purpose.
*.jks
*.keystore
*.p12
!app/signing/dev.keystore
