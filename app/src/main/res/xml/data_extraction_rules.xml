<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cloud sync's link and position (SyncPreferences) stay on this phone: restored elsewhere they wouldn't
         match the data. A restored phone links to the account afresh. -->
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="datastore/sync.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="datastore/sync.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
